# fal.ai API key for image generation (fal.ai/dashboard/keys). Used by scripts/bakeoff.ts and lib/generate.ts.
FAL_KEY=your-fal-key

# Supabase project URL (Dashboard → Project Settings → API). Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_…), safe in the browser. Read-only through RLS; used for the Realtime grid.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Secret key (sb_secret_…), server only: bypasses RLS. Never prefix with NEXT_PUBLIC_; lib/supabase/server.ts imports server-only.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Firecrawl API key (firecrawl.dev/app/api-keys), for the `branding` scrape in lib/brand.ts. Optional: without it, research falls back to the homepage HTML.
FIRECRAWL_API_KEY=fc-your-key
# Anthropic API key (console.anthropic.com → API Keys). Serves every LLM call through lib/llm.ts.
ANTHROPIC_API_KEY=sk-ant-your-key
# Model id for LLM calls. Optional, defaults to claude-sonnet-5-5 (direct Anthropic ids use dashes).
LLM_MODEL=claude-sonnet-5-5
# Only if lib/llm.ts is switched back to the Vercel AI Gateway (see the comment there); then LLM_MODEL takes a gateway id like anthropic/claude-sonnet-5.5.
# AI_GATEWAY_API_KEY=your-gateway-key
