{
  "name": "ploy-ads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bakeoff": "tsx --env-file-if-exists=.env.local scripts/bakeoff.ts",
    "verify:m1": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-m1.ts",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts && oxfmt lib/supabase/database.types.ts",
    "db:types:linked": "supabase gen types typescript --linked --schema public > lib/supabase/database.types.ts && oxfmt lib/supabase/database.types.ts",
    "test": "tsx --conditions=react-server --test \"lib/**/*.test.ts\"",
    "research": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/research.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/react": "^4.0.158",
    "@fal-ai/client": "^1.10.1",
    "@mendable/firecrawl-js": "^4.51.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.154",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "motion": "^14.6.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "oxfmt": "^0.75.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
